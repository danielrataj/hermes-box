# Settings of one installation. Becomes instance/.env (install.sh does that on
# its first run). No secrets belong here; those are in secrets/*.enc.yaml.

# Public host name of the Webapp; its DNS record must point at this server.
HERMES_DOMAIN=

# Private age key that decrypts secrets/*.enc.yaml (root, mode 600).
# install.sh creates it if it is missing.
# SOPS_AGE_KEY_FILE=/etc/hermes/credentials/age.key

# Further paths inside the data directory to back up, separated by spaces,
# e.g. the state of a container from your own compose.yaml in this directory.
# BACKUP_EXTRA_PATHS=

# true: the server fetches this repository every 5 minutes and deploys new
# commits by itself (deploy/hermes-deploy.sh). Whoever can push to the
# deployed branch then runs code as root here.
# AUTO_DEPLOY=true

# Where all state lives; ideally the mount point of a separate volume.
# HERMES_DATA_DIR=/home/hermes
# Owner of that data.
# HERMES_UID=1000
# HERMES_GID=1000

# The image to run, when it should differ from the one this installation
# came with (release.env): a specific published version, or your own build.
# HERMES_BOX_IMAGE=ghcr.io/danielrataj/hermes-box:1.0.0

# Only where the image is built on this server: the Hermes version to build
# on, instead of the one pinned in the Dockerfile, e.g. v0.23.1-desktop for
# Bot Desktop.
# HERMES_IMAGE_TAG=
